# Custom Backend API URL (for Vercel/production deployment)
# In development, Vite proxy handles /api -> localhost:3001 automatically
VITE_API_URL=/api

# ---------------------------------------------------------------------------
# SMTP for the recruit email OTP flow (server-side, no VITE_ prefix).
# PRIMARY: manage up to 10 Gmail SMTP accounts in the Admin panel
# (/admin/smtp). They are stored in public.smtp_settings (super-admin,
# MFA-gated) and used for OTP sends with silent failover — account #1 is tried
# first, then #2, #3, ... and only if every configured account fails does the
# user see an error. If 1 or 2 accounts are entered, only those are used.
#
# FALLBACK (optional, legacy): these env secrets are only used when NO
# accounts are configured in the admin panel. SERVER-SIDE ONLY — no VITE_
# prefix, so Vite never exposes them to the browser.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ciie@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="KL CIIE <ciie@gmail.com>"
